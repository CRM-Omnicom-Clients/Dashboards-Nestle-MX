timezone: America/Mexico_City

_export:
  td:
    engine: presto

# Pre-requisito: correr scripts/reload_catalog.py si el catálogo cambió
+catalogo:
  call>: catalogo.dig

+hechos:
  call>: hechos.dig

+reporte:
  call>: reporte.dig

_error:
  mail>: Reporte Consolidado — pipeline falló
  subject: "[nmx_crm_reporte] nmx_crm_reporte.dig FALLÓ — ${session_date}"
  to: [rick@omnicommediagroup.com]
